{
  "name": "engineering-knowledge-operations",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted internal documentation with org hierarchy and lead-controlled publishing.",
  "packageManager": "pnpm@12.14.0+sha512.c18ba6d87993d3d164cb5e8948f32b2c06ee854487e06cd8d86781342fb3e5bb4634367034711e86802baa9c37bea906ce1929ad08d70884c97d801df13389a6",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "lint": "eslint .",
    "check:permissions": "bash scripts/check-permission-drift.sh",
    "check:i18n": "pnpm --filter frontend run check:i18n && pnpm --filter backend run check:mail-i18n",
    "verify": "pnpm run lint && pnpm run check:permissions && pnpm run check:i18n && pnpm run format:check && pnpm --filter backend run build && pnpm --filter frontend run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,tsx,json,md,yml,yaml,css,scss,html}": "prettier --write",
    "*.{js,mjs,cjs,ts,tsx}": "eslint --fix"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "eslint": "^9.15.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "husky": "^9.1.7",
    "jscpd": "^4.0.9",
    "knip": "^6.42.1",
    "lint-staged": "^15.4.3",
    "prettier": "^3.9.10",
    "prisma": "^7.10.1",
    "ts-prune": "^0.10.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.72.0"
  },
  "dependencies": {
    "@prisma/client": "^7.10.1"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "4.64.12",
    "@rollup/rollup-linux-x64-musl": "4.64.12"
  }
}

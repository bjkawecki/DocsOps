{
  "name": "landing",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Marketing landing page for DocsOps",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:lab": "tsc -b && vite build --outDir dist-local",
    "build:public": "tsc -b && vite build --outDir dist-public",
    "prerender": "tsx scripts/prerender.ts",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0"
  },
  "dependencies": {
    "@mantine/core": "^9.7.3",
    "@mantine/hooks": "^9.7.3",
    "@tabler/icons-react": "^3.49.0",
    "@xyflow/react": "^12.12.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.4",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "playwright": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vite": "^8.3.4"
  }
}
